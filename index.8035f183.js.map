"use strict";
var table = document.querySelector("#table");
var rows = table.rows;
var headerName = rows[0].cells[0];
var headerPosition = rows[0].cells[1];
var headerAge = rows[0].cells[2];
var headerSalary = rows[0].cells[3];
headerName.onclick = function() {
    var SORTBY = "name";
    sorting(rows, SORTBY);
};
headerPosition.onclick = function() {
    var SORTBY = "position";
    sorting(rows, SORTBY);
};
headerAge.onclick = function() {
    var SORTBY = "age";
    sorting(rows, SORTBY);
};
headerSalary.onclick = function() {
    var SORTBY = "salary";
    sorting(rows, SORTBY);
};
function sorting(items, sortBy) {
    var count = items.length - 2;
    while(count > 0){
        for(var i = 1; i < items.length - 2; i++){
            var item = items[i];
            var itemNext = items[i + 1];
            switch(sortBy){
                case "name":
                    if (items[i].cells[0].innerText.localeCompare(items[i + 1].cells[0].innerText) > 0) itemNext.after(item);
                    break;
                case "position":
                    if (items[i].cells[1].innerText.localeCompare(items[i + 1].cells[1].innerText) > 0) itemNext.after(item);
                    break;
                case "age":
                    var age1 = items[i].cells[2].innerText;
                    var age2 = items[i + 1].cells[2].innerText;
                    if (+age1 > +age2) itemNext.after(item);
                    break;
                case "salary":
                    var regex = /\W/g;
                    var number1 = items[i].cells[3].innerText.replaceAll(regex, "");
                    var number2 = items[i + 1].cells[3].innerText.replaceAll(regex, "");
                    if (+number1 > +number2) itemNext.after(item);
                    break;
            }
        }
        count--;
    }
}

